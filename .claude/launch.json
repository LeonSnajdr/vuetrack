{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "app",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["--prefix", "sources/Vuetrack.App", "run", "dev"],
            "port": 9100,
            "autoPort": true
        },
        {
            "name": "fake-api",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["--prefix", "sources/fake-api", "run", "dev"],
            "port": 5001
        },
        {
            "name": "api",
            "runtimeExecutable": "dotnet",
            "runtimeArgs": ["run", "--project", "sources/Vuetrack.Api/Vuetrack.Api", "--launch-profile", "core"],
            "port": 9200
        }
    ]
}
