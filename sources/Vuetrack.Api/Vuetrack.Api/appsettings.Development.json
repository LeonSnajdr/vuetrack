{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Serilog.AspNetCore": "Information"
      }
    }
  },
  "LoggingOptions": {
    "LogFolder": "..\\..\\..\\logs\\",
    "EnableElasticLogging": false,
    "EnableConsoleLogging": true
  },
  "CorsPolicyOptions": {
    "DomainUrls": ["*"]
  }
}
